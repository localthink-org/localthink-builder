{
  "manifest_version": 3,
  "name": "LTF Builder",
  "description": "Export ChatGPT, Claude, and Gemini conversations as LocalThink Format (.ltf.md) files.",
  "version": "0.2.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "LTF Builder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting"]
}
